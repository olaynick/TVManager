<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCL TV Manager" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F7F7FA"
        MinHeight="550" MinWidth="700">

        <Window.Resources>
        <!-- Кнопка -->
        <Style TargetType="Button" x:Key="RoundedButton">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="BackButton" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#E57373"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,20,20"/>
        </Style>

        <!-- Поле ввода -->
        <Style TargetType="TextBox" x:Key="RoundedTextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="CaretBrush" Value="#000000"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Чекбокс -->
        <Style TargetType="CheckBox" x:Key="MiuiCheckBox">
            <Setter Property="Foreground" Value="#2D2D30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="CheckBorder"
                                        Grid.Column="0"
                                        Width="22" Height="22"
                                        Background="White"
                                        BorderBrush="#D0D0D5"
                                        BorderThickness="1.5"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                    <Viewbox x:Name="CheckMark"
                                             Width="14" Height="14"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed">
                                        <Path Data="M 2,7 L 6,11 L 13,3"
                                              Stroke="White"
                                              StrokeThickness="2.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Viewbox>
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#4A90E2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#4A90E2"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#4A90E2"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладки -->
        <Style TargetType="TabItem" x:Key="MiuiTabItem">
            <Setter Property="Foreground" Value="#2D2D30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#F0F0F5"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E4E4EC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#4A90E2"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl" x:Key="MiuiTabControlTemplate">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,10"/>
                            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="5">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- Контент -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ContentGrid" Margin="0"/>
        </ScrollViewer>

        <!-- Панель кнопок внизу -->
        <Border Grid.Row="1" x:Name="BottomBar" Background="#F0F0F5" 
                BorderBrush="#E1E1E6" BorderThickness="0,1,0,0" Padding="15,10"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="BottomBarProgress"
                            Grid.Column="0"
                            Width="200"
                            Height="6"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Foreground="#4A90E2"
                            Background="#E1E1E6"
                            BorderThickness="0"/>

                <StackPanel x:Name="BottomBarContent"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"/>

                <TextBlock x:Name="BottomBarProgressText"
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#96969B"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" x:Name="StatusBar" Background="White" 
                BorderBrush="#E1E1E6" BorderThickness="0,1,0,0" Padding="15,6">
            <TextBlock x:Name="StatusText" Text="● Не подключено" Foreground="#E57373" FontSize="13"/>
        </Border>

        <Border Grid.Row="3" Background="#282A30">
            <RichTextBox x:Name="LogBox" Background="#282A30" Foreground="#D2D2D7" 
                         FontFamily="Consolas" FontSize="11" IsReadOnly="True" 
                         BorderThickness="0" Padding="10" VerticalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</Window>